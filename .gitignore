# --- Секреты ---
# .env хранит ключи и адреса — в репозиторий он попадать не должен.
# Файл .env.production специально НЕ игнорируется: в нём только публичный
# адрес бэкенда, и он нужен Cloudflare при сборке.
.env
.env.local
.env.*.local

